{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacLoader",
  "version": "1.1.0",
  "identifier": "com.macloader.gui",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MacLoader — 免杀马生成器 (macOS)",
        "width": 1180,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
